# Copy to .env (docker compose reads it). Every setting is optional for local development.
POSTGRES_PASSWORD=change-me
# Set to true when serving over HTTPS (marks the session cookie Secure)
BUILDER_COOKIE_SECURE=false
# Close signups on a public instance once your own account exists
BUILDER_ALLOW_REGISTRATION=true
# Behind a reverse proxy you control: honour X-Forwarded-For for rate limiting
BUILDER_TRUST_PROXY=false
# File storage: "local" (a volume) or "s3" (MinIO / Cloudflare R2 / AWS S3)
BUILDER_STORAGE_BACKEND=local
# BUILDER_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# BUILDER_S3_BUCKET=builder-uploads
# BUILDER_S3_ACCESS_KEY=...
# BUILDER_S3_SECRET_KEY=...
