{% set img = ctx.image(p.image) %}
{% if s.variant == "cover" %}
{% set vid = ctx.youtube_id(p.video_url) if p.video_url else None %}
<div class="hero-cover hc-{{ p.height }} ov-{{ p.overlay }}">
  <div class="cover-media" aria-hidden="true">
    {% if img %}<img src="{{ img.src }}" alt=""{% if img.width %} width="{{ img.width }}" height="{{ img.height }}"{% endif %} fetchpriority="high">{% endif %}
    {% if vid %}<div class="cover-video" data-yt-bg="{{ vid }}"></div>{% endif %}
  </div>
  <div class="cover-scrim"></div>
  <div class="container cover-inner">
    <div class="hero-copy">
      {% if p.eyebrow %}<p class="eyebrow">{{ p.eyebrow }}</p>{% endif %}
      <h1>{{ p.heading }}</h1>
      {% if p.subheading %}<p class="lead">{{ p.subheading }}</p>{% endif %}
      {% if p.buttons %}
      <div class="buttons">
        {% for b in p.buttons %}<a class="btn btn-{{ b.style }}" href="{{ ctx.link(b.href) }}">{{ b.label }}</a>{% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% if vid %}<button type="button" class="cover-toggle" data-pause="{{ ctx.t('pause_background') }}" data-play="{{ ctx.t('play_background') }}" aria-label="{{ ctx.t('pause_background') }}" hidden></button>{% endif %}
</div>
{% elif s.variant == "banner" %}
{% set vid = None %}
<div class="hero-banner">
  <div class="hb-head">
    {% if p.eyebrow %}<p class="eyebrow">{{ p.eyebrow }}</p>{% endif %}
    <h1>{{ p.heading }}</h1>
  </div>
  <div class="hb-side">
    {% if p.subheading %}<p class="lead">{{ p.subheading }}</p>{% endif %}
    {% if p.buttons %}<div class="buttons">{% for b in p.buttons %}<a class="btn btn-{{ b.style }}" href="{{ ctx.link(b.href) }}">{{ b.label }}</a>{% endfor %}</div>{% endif %}
  </div>
</div>
{% if img %}<div class="hero-media hb-media"><img src="{{ img.src }}" alt="{{ img.alt }}"{% if img.width %} width="{{ img.width }}" height="{{ img.height }}"{% endif %}></div>{% endif %}
{% else %}
<div class="hero-grid{% if img and s.variant == 'split' %} has-image{% endif %}{% if p.image_position == 'start' %} image-start{% endif %}">
  <div class="hero-copy">
    {% if p.eyebrow %}<p class="eyebrow">{{ p.eyebrow }}</p>{% endif %}
    <h1>{{ p.heading }}</h1>
    {% if p.subheading %}<p class="lead">{{ p.subheading }}</p>{% endif %}
    {% if p.buttons %}
    <div class="buttons">
      {% for b in p.buttons %}<a class="btn btn-{{ b.style }}" href="{{ ctx.link(b.href) }}">{{ b.label }}</a>{% endfor %}
    </div>
    {% endif %}
  </div>
  {% if img %}
  <div class="hero-media"><img src="{{ img.src }}" alt="{{ img.alt }}"{% if img.width %} width="{{ img.width }}" height="{{ img.height }}"{% endif %}></div>
  {% endif %}
</div>
{% endif %}
