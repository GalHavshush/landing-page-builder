{% from "_macros.html.j2" import head, img as picture %}
{{ head(p) }}
<div class="grid cols-{{ fit_cols(p.columns, p.items|length) }} svc-{{ s.variant }}">
  {% for it in p.items %}
  {% set img = ctx.image(it.image) %}
  <article class="item">
    {% if img %}{{ picture(img, "(min-width:960px) 370px, (min-width:600px) 50vw, 100vw") }}{% endif %}
    <div class="svc-body">
      <div class="svc-top"><h3>{{ it.title }}</h3>{% if it.price %}<span class="price">{{ it.price }}</span>{% endif %}</div>
      {% if it.description %}<p>{{ it.description }}</p>{% endif %}
      {% if it.link %}<a href="{{ ctx.link(it.link) }}">{{ ctx.t("learn_more") }}</a>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>
