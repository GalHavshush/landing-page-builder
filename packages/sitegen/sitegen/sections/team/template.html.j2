{% from "_macros.html.j2" import head, img as picture %}
{{ head(p) }}
{% set n = p.items|length %}
<div class="grid cols-{{ fit_cols(p.columns, n) if n else p.columns }} team-{{ s.variant }}">
  {% for m in p.items %}
  {% set photo = ctx.image(m.photo) %}
  <article class="item member">
    <div class="member-photo">{% if photo %}{{ picture(photo, "(min-width:960px) 340px, (min-width:600px) 50vw, 100vw") }}{% else %}<span class="ph" aria-hidden="true">{{ (m.name or "?")[:1] }}</span>{% endif %}</div>
    <div class="member-body">
      <h3>{{ m.name }}</h3>
      {% if m.role %}<p class="role">{{ m.role }}</p>{% endif %}
      {% if m.bio %}<p class="bio">{{ m.bio }}</p>{% endif %}
    </div>
  </article>
  {% endfor %}
</div>
