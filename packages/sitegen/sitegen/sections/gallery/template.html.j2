{% from "_macros.html.j2" import head, img as picture %}
{{ head(p) }}
<div class="gallery cols-{{ p.columns }}">
  {% for it in p.items %}
  {% set img = ctx.image(it.image) %}
  {% if img %}
  <figure>
    {{ picture(img, "(min-width:900px) 400px, 50vw") }}
    {% if it.caption %}<figcaption>{{ it.caption }}</figcaption>{% endif %}
  </figure>
  {% endif %}
  {% endfor %}
</div>
