        {"id": "sec_home_features", "type": "features", "variant": "cards", "style": {},
         "props": {"heading": "Why choose us", "subheading": "A few things we do really well.",
                   "items": [{"icon": "star", "title": "Quality", "text": "Made with care, every time."},
                             {"icon": "clock", "title": "Fast", "text": "Quick turnaround you can rely on."},
                             {"icon": "heart", "title": "Friendly", "text": "We treat every customer like family."}]}},
        {"id": "sec_home_testimonials", "type": "testimonials", "variant": "cards", "style": {"background": "alt"},
         "props": {"heading": "What customers say",
                   "items": [{"quote": "Absolutely wonderful. Highly recommended!", "author": "Alex P.", "role": "Customer"},
                             {"quote": "Great service and lovely people.", "author": "Sam R.", "role": "Customer"}]}}
      ]
    },
    {
      "id": "pg_services", "slug": "services", "title": "Services",
      "sections": [
        {"id": "sec_services_list", "type": "services", "variant": "cards", "style": {},
         "props": {"heading": "Our services", "subheading": "Clear pricing, no surprises.",
                   "items": [{"title": "Consultation", "description": "Tell us what you need.", "price": "$50"},
                             {"title": "Standard package", "description": "Our most popular option.", "price": "$150"},
                             {"title": "Premium package", "description": "Everything included.", "price": "$300"}]}},
        {"id": "sec_services_faq", "type": "faq", "variant": "accordion", "style": {"background": "alt"},
         "props": {"heading": "Questions", "items": [{"question": "How do I get started?", "answer": "Just get in touch and we will help."},
                                                      {"question": "Do you offer refunds?", "answer": "Yes, within 30 days."}]}}
      ]
    },
    {
      "id": "pg_about", "slug": "about", "title": "About",
      "seo": {"description": "Learn more about our story."},
      "sections": [
        {"id": "sec_about_text", "type": "text", "variant": "single", "style": {},
         "props": {"heading": "Our story", "body": "We started with a simple idea: do good work and treat people well.\n\nToday we help customers across the region."}}
      ]
