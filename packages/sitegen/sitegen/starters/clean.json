    "footer": {"text": "", "show_business_info": true}
  },
  "theme": {
    "template": "clean",
    "palette": {"primary": "#2563EB", "accent": "#F59E0B", "background": "#FFFFFF", "surface": "#F3F4F6", "text": "#111827"},
    "fonts": {"heading": "sans", "body": "sans"},
    "radius": "md", "button_style": "solid", "spacing": "normal"
  },
  "pages": [
    {
      "id": "pg_home", "slug": "", "title": "Home",
      "sections": [
        {"id": "sec_home_hero", "type": "hero", "variant": "centered",
         "style": {"background": "alt", "spacing": "spacious", "align": "center"},
         "props": {"eyebrow": "Welcome", "heading": "We help your business look its best",
