<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ head.title }}</title>
{% if head.description %}<meta name="description" content="{{ head.description }}">{% endif %}
{% if head.noindex %}<meta name="robots" content="noindex">{% endif %}
{% if head.canonical %}<link rel="canonical" href="{{ head.canonical }}">{% endif %}
{% for hreflang, url in head.alternates %}<link rel="alternate" hreflang="{{ hreflang }}" href="{{ url }}">
{% endfor %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ head.title }}">
{% if head.description %}<meta property="og:description" content="{{ head.description }}">{% endif %}
{% if head.canonical %}<meta property="og:url" content="{{ head.canonical }}">{% endif %}
<meta property="og:site_name" content="{{ site.name }}">
{% if head.image %}<meta property="og:image" content="{{ head.image }}">{% endif %}
<meta name="twitter:card" content="{{ 'summary_large_image' if head.image else 'summary' }}">
{% if preview %}<style>{{ inline_css|safe }}</style>{% else %}<link rel="stylesheet" href="{{ css_href }}">
<script src="{{ js_href }}" defer></script>{% endif %}
</head>
<body class="tpl-{{ doc.theme.template }} btn-style-{{ doc.theme.button_style }}">
<a class="skip" href="#main">{{ ctx.t("skip") }}</a>
<header class="site-header">
  <div class="container">
    <a class="brand" href="{{ home_href }}">{{ site.name }}</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="{{ ctx.t('menu') }}">&#9776;</button>
    <nav class="nav" aria-label="Main">
      {% for item in nav %}<a href="{{ item.href }}"{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
    {% if languages %}<div class="langs" aria-label="Language">{% for l in languages %}<a href="{{ l.href }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.current %} aria-current="true"{% endif %}>{{ l.label }}</a>{% endfor %}</div>{% endif %}
  </div>
</header>
<main id="main">
{% for html in sections_html %}{{ html|safe }}
{% endfor %}</main>
<footer class="site-footer">
  <div class="container">
    <div class="cols">
      <div><h3>{{ site.name }}</h3>{% if site.tagline %}<p>{{ site.tagline }}</p>{% endif %}</div>
      {% if doc.site.footer.show_business_info %}
      <div>
        <h3>{{ ctx.t("contact") }}</h3>
        <ul>
          {% if site.phone %}<li><a href="tel:{{ site.phone }}">{{ site.phone }}</a></li>{% endif %}
          {% if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
          {% if site.address %}<li>{{ site.address }}</li>{% endif %}
        </ul>
      </div>
      {% if site.hours %}
      <div>
        <h3>{{ ctx.t("hours") }}</h3>
        <ul>{% for h in site.hours %}<li>{{ h.label }}: {% if h.closed %}{{ ctx.t("closed") }}{% else %}{{ h.open }}&ndash;{{ h.close }}{% endif %}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% endif %}
    </div>
    {% if site.footer_text %}<div class="footer-note">{{ site.footer_text }}</div>{% endif %}
  </div>
</footer>
{% if preview %}<script>{{ inline_js|safe }}</script><script>{{ preview_js|safe }}</script>{% endif %}
</body>
</html>
