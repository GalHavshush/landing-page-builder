<!doctype html>
<html lang="{{ lang }}" dir="{{ dir }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="{{ doc.theme.palette.background }}">
<link rel="icon" href="{{ head.favicon }}">
<title>{{ head.title }}</title>
{% if head.description %}<meta name="description" content="{{ head.description }}">{% endif %}
{% if head.noindex %}<meta name="robots" content="noindex">{% endif %}
{% if head.canonical %}<link rel="canonical" href="{{ head.canonical }}">{% endif %}
{% for hreflang, url in head.alternates %}<link rel="alternate" hreflang="{{ hreflang }}" href="{{ url }}">
{% endfor %}
<meta property="og:type" content="{{ head.og_type }}">
<meta property="og:title" content="{{ head.title }}">
{% if head.description %}<meta property="og:description" content="{{ head.description }}">{% endif %}
{% if head.canonical %}<meta property="og:url" content="{{ head.canonical }}">{% endif %}
<meta property="og:site_name" content="{{ site.name }}">
{% if head.image %}<meta property="og:image" content="{{ head.image }}">{% endif %}
{% if head.jsonld %}<script type="application/ld+json">{{ head.jsonld|safe }}</script>
{% endif %}<meta name="twitter:card" content="{{ 'summary_large_image' if head.image else 'summary' }}">
{% if preview %}<style>{{ inline_css|safe }}</style>{% else %}<link rel="stylesheet" href="{{ css_href }}">
<script src="{{ js_href }}" defer></script>{% endif %}
</head>
<body class="tpl-{{ doc.theme.template }} btn-style-{{ doc.theme.button_style }} cards-{{ doc.theme.card_style }} imgs-{{ doc.theme.image_style }} heads-{{ doc.theme.heading_style }} motion-{{ doc.theme.motion }}{% if header.overlay %} has-overlay-header{% endif %}">
<a class="skip" href="#main">{{ ctx.t("skip") }}</a>
{% from "_macros.html.j2" import img as picture %}
{% if header.announcement %}
<div class="announce">{% if header.announcement.href %}<a href="{{ header.announcement.href }}">{{ header.announcement.text }}</a>{% else %}<span>{{ header.announcement.text }}</span>{% endif %}</div>
{% endif %}
<header class="site-header hdr-{{ header.style }}{% if header.overlay %} hdr-overlay hdr-tone-{{ header.tone }}{% endif %}{% if not header.sticky %} hdr-static{% endif %}">
  <div class="container hdr-bar">
    {% macro brand() %}<a class="brand{% if header.logo %} has-logo{% endif %}" href="{{ home_href }}"{% if header.logo %} aria-label="{{ site.name }}"{% endif %}>{% if header.logo %}{{ picture(header.logo, "240px", "brand-logo logo-" ~ header.logo_size, true, "") }}{% else %}{{ site.name }}{% endif %}</a>{% endmacro %}
    {% macro menu() %}<nav class="nav" aria-label="Main">{% for item in nav %}<a href="{{ item.href }}"{% if preview %} data-page-id="{{ item.page_id }}"{% endif %}{% if item.current %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>{% endmacro %}
    {% macro extras() %}{% if languages %}<div class="langs" aria-label="Language">{% for l in languages %}<a href="{{ l.href }}" hreflang="{{ l.code }}" lang="{{ l.code }}"{% if l.current %} aria-current="true"{% endif %}>{{ l.label }}</a>{% endfor %}</div>{% endif %}{% if header.cta %}<a class="btn btn-{{ header.cta.style }} hdr-cta" href="{{ header.cta.href }}">{{ header.cta.label }}</a>{% endif %}{% endmacro %}
    {% if header.style == "split" %}
    <div class="hdr-left">{{ menu() }}</div>
    {{ brand() }}
    <div class="hdr-right">{{ extras() }}<button class="nav-toggle" type="button" aria-expanded="false" aria-label="{{ ctx.t('menu') }}"><span></span><span></span></button></div>
    {% else %}
    {{ brand() }}
    <button class="nav-toggle" type="button" aria-expanded="false" aria-label="{{ ctx.t('menu') }}"><span></span><span></span></button>
    {{ menu() }}
    <div class="hdr-right">{{ extras() }}</div>
    {% endif %}
  </div>
</header>
<main id="main">
{% for html in sections_html %}{{ html|safe }}
{% endfor %}</main>
<footer class="site-footer ftr-{{ doc.site.footer.style }}">
  <div class="container">
    {% if doc.site.footer.style == "minimal" %}
    <div class="ftr-line">
      <a class="brand" href="{{ home_href }}">{{ site.name }}</a>
      {% if nav %}<nav class="footer-nav" aria-label="{{ ctx.t('menu') }}">{% for item in nav %}<a href="{{ item.href }}"{% if preview %} data-page-id="{{ item.page_id }}"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>{% endif %}
    </div>
    {% else %}
    <div class="cols">
      <div>
        <a class="brand" href="{{ home_href }}">{{ site.name }}</a>
        {% if site.tagline %}<p>{{ site.tagline }}</p>{% endif %}
        {% if nav %}<nav class="footer-nav" aria-label="{{ ctx.t('menu') }}">{% for item in nav %}<a href="{{ item.href }}"{% if preview %} data-page-id="{{ item.page_id }}"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>{% endif %}
      </div>
      {% if doc.site.footer.show_business_info %}
      {% if site.phone or site.email or site.address %}
      <div>
        <h3>{{ ctx.t("contact") }}</h3>
        <ul>
          {% if site.phone %}<li><a href="tel:{{ site.phone }}">{{ site.phone }}</a></li>{% endif %}
          {% if site.email %}<li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>{% endif %}
          {% if site.address %}<li>{{ site.address }}</li>{% endif %}
        </ul>
      </div>
      {% endif %}
      {% if site.hours %}
      <div>
        <h3>{{ ctx.t("hours") }}</h3>
        <ul>{% for h in site.hours %}<li>{{ h.label }}: {% if h.closed %}{{ ctx.t("closed") }}{% else %}{{ h.open }}&ndash;{{ h.close }}{% endif %}</li>{% endfor %}</ul>
      </div>
      {% endif %}
      {% endif %}
    </div>
    {% endif %}
    {%- if site.social %}<ul class="social" aria-label="Social">{% for s in site.social %}<li><a href="{{ s.href }}" rel="noopener" target="_blank">{{ s.label }}</a></li>{% endfor %}</ul>{% endif %}
    <div class="footer-note"><span>&copy; {{ site.name }}</span>{% if site.footer_text %}<span>{{ site.footer_text }}</span>{% endif %}</div>
  </div>
</footer>
{% if preview %}<script>{{ inline_js|safe }}</script><script>{{ preview_js|safe }}</script>{% endif %}
</body>
</html>
