{% from "_macros.html.j2" import img as picture %}
<article class="post">
  <header>
    <p class="post-meta"><time datetime="{{ post.iso_date }}">{{ post.date }}</time></p>
    <h1>{{ post.title }}</h1>
    {% if post.excerpt %}<p class="lead">{{ post.excerpt }}</p>{% endif %}
  </header>
  {% if post.cover %}{{ picture(post.cover, "(min-width:800px) 736px, 100vw", "post-hero", true, "") }}{% endif %}
  <div class="prose">{{ body }}</div>
  <p class="post-back"><a href="{{ back_href }}">&larr; {{ ctx.t("back_to_blog") }}</a></p>
</article>
